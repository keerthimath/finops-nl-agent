# --- ADX / FinOps Hub ---
ADX_CLUSTER_URI=https://<cluster>.<region>.kusto.windows.net
ADX_DATABASE=Hub
# Comma-separated entities the agent may query (functions include the parentheses)
ALLOWED_ENTITIES='Costs_v1_2(),Recommendations()'

# Optional: ADX dashboard export whose tiles the model can run (see dashboards/README.md)
DASHBOARD_FILE=

# --- LLM ---
# anthropic = Anthropic API (ANTHROPIC_API_KEY). foundry = Claude on Microsoft Foundry. openai = OpenAI API.
LLM_PROVIDER=anthropic
# Model id; for Foundry, the deployment name
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Foundry resource name: <name> in https://<name>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=
# entra = DefaultAzureCredential (managed identity in Azure, `az login` locally; needs Cognitive Services User
# on the Foundry resource). key = ANTHROPIC_FOUNDRY_API_KEY.
FOUNDRY_AUTH=entra
ANTHROPIC_FOUNDRY_API_KEY=
# LLM_PROVIDER=openai: prompts and evals are tuned for Claude; run evals before relying on it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Hidden reasoning drives most of the latency and output tokens. low | medium | high; empty = provider default.
OPENAI_REASONING_EFFORT=medium
# LLM_PROVIDER=azure_openai: an Azure OpenAI deployment in Foundry. OPENAI_REASONING_EFFORT applies too; set it
# empty for non-reasoning models (gpt-4o, gpt-4.1). entra = managed identity / az login (needs Cognitive Services
# User on the resource); key = AZURE_OPENAI_API_KEY.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_AUTH=entra
AZURE_OPENAI_API_KEY=

# --- Auth ---
# obo = users sign in with Entra, ADX sees the real user (RLS applies). Use this in any shared deployment.
# dev = your own `az login` identity, NO per-user scoping. Local development only.
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# secret = ENTRA_CLIENT_SECRET (local obo testing). managed_identity = no secret: the app registration trusts the
# Container App's user-assigned managed identity (federated credential); set ENTRA_MI_CLIENT_ID to its client id.
ENTRA_CREDENTIAL=secret
ENTRA_CLIENT_SECRET=
ENTRA_MI_CLIENT_ID=
CHAINLIT_AUTH_SECRET=   # chainlit create-secret

# --- Admin page (/admin) ---
# Comma-separated sign-in names allowed on /admin (AUTH_MODE=dev: anyone, it's local)
ADMIN_USERS=
# Comma-separated Entra group object IDs allowed on /admin (requires a groups claim in the ID token)
ADMIN_GROUP_IDS=
# Log Analytics workspace (customer) id with the Container Apps logs; empty = this process's recent questions
ADMIN_LOG_WORKSPACE_ID=
# Optional USD per million tokens for the cost estimate, e.g. 1.25 / 0.125 / 10
PRICE_INPUT_PER_MTOK=
PRICE_CACHED_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# --- A2A (Agent2Agent) ---
# true = other agents can ask questions for a signed-in user: GET /.well-known/agent-card.json, JSON-RPC POST /a2a.
# With AUTH_MODE=obo they must send the user's delegated token (api://<client-id>/access_as_user); see docs/a2a.md.
# The card advertises CHAINLIT_URL (required with obo).
A2A_ENABLED=false

# --- Limits ---
MAX_ROWS=500
LLM_ROWS=30
QUERY_TIMEOUT_SECONDS=60
MAX_TOOL_ITERATIONS=8
# Per-question budget (input + output tokens); the agent stops and asks to narrow the question.
MAX_TURN_TOKENS=150000
